# Copy to .env next to docker-compose.yml.

# Docker network SWAG is on. On Unraid: Docker tab -> SWAG -> "Network Type".
# Also listed by: docker inspect swag --format '{{json .NetworkSettings.Networks}}'
SWAG_NETWORK=proxynet

# Optional invite key. When set, the site and the relay only answer browsers
# that opened https://zelda.phatt.vip/?key=<this> once (a cookie remembers it).
# Leave empty for an open site. Generate one with: openssl rand -hex 12
ACCESS_KEY=
