+// #4060 trailer capture build only: a scripted main camera. Mode 1 flies from
+// eye0/at0 to eye1/at1 in world space, mode 2 does the same relative to Link,
+// mode 3 orbits at0..at1 with eye = (angle deg, height, radius). Eased over n frames.
+s32 gTrailerCamMode = 0;
+s32 gTrailerHideHud = 0;
+static f32 sTrailerK[14];
+static s32 sTrailerFrames = 1;
+static s32 sTrailerFrame = 0;
+
+#ifdef __EMSCRIPTEN__
+EMSCRIPTEN_KEEPALIVE
+#endif
+void sevendays_test_cam(s32 mode, f32 ex0, f32 ey0, f32 ez0, f32 ax0, f32 ay0, f32 az0, f32 ex1, f32 ey1, f32 ez1,
+                        f32 ax1, f32 ay1, f32 az1, s32 frames, f32 fov0, f32 fov1, s32 hideHud) {
+    f32 k[14] = { ex0, ey0, ez0, ax0, ay0, az0, ex1, ey1, ez1, ax1, ay1, az1, fov0, fov1 };
+    memcpy(sTrailerK, k, sizeof(k));
+    gTrailerCamMode = mode;
+    gTrailerHideHud = hideHud;
+    sTrailerFrames = frames < 1 ? 1 : frames;
+    sTrailerFrame = 0;
+}
+
+static void Camera_TrailerOverride(Camera* camera) {
+    f32* k = sTrailerK;
+    f32 t = (f32)sTrailerFrame / sTrailerFrames;
+    f32 e = t * t * (3.0f - 2.0f * t);
+    Vec3f eye, at;
+    if (sTrailerFrame < sTrailerFrames) {
+        sTrailerFrame++;
+    }
+    at.x = k[3] + (k[9] - k[3]) * e;
+    at.y = k[4] + (k[10] - k[4]) * e;
+    at.z = k[5] + (k[11] - k[5]) * e;
+    if (gTrailerCamMode == 3) {
+        f32 ang = (k[0] + (k[6] - k[0]) * e) * (M_PI / 180.0f);
+        f32 r = k[2] + (k[8] - k[2]) * e;
+        eye.x = at.x + sinf(ang) * r;
+        eye.y = at.y + k[1] + (k[7] - k[1]) * e;
+        eye.z = at.z + cosf(ang) * r;
+    } else {
+        eye.x = k[0] + (k[6] - k[0]) * e;
+        eye.y = k[1] + (k[7] - k[1]) * e;
+        eye.z = k[2] + (k[8] - k[2]) * e;
+    }
+    if (gTrailerCamMode == 2 && camera->player != NULL) {
+        Vec3f* p = &camera->player->actor.world.pos;
+        eye.x += p->x; eye.y += p->y; eye.z += p->z;
+        at.x += p->x; at.y += p->y; at.z += p->z;
+    }
+    camera->eye = camera->eyeNext = eye;
+    camera->at = at;
+    camera->fov = k[12] + (k[13] - k[12]) * e;
+    camera->roll = 0;
+}
